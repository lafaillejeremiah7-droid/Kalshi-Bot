TWELVE_DATA_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SYMBOL=XAU/USD
TIMEFRAMES=1min,5min,15min,1h,4h
RESEARCH_INTERVAL=15min
OUTPUT_SIZE=3000
CONTEXT_OUTPUT_SIZE=500
POLL_SECONDS=60
MIN_CONFIDENCE=0.72
MIN_CONSENSUS=3

# Research lab: 20,000 candidates sampled across a 27k+ strategy universe.
MAX_CANDIDATES=20000
RESEARCH_CATALOG_SIZE=600
WALK_FORWARD_FOLDS=4
MIN_WALK_FORWARD_FOLDS=2
RESEARCH_EVERY_CYCLES=60
SPREAD_BPS=1.5
PAPER_MODE=true

# Optional macro context. If a symbol is unavailable on your Twelve Data plan,
# the corresponding desk safely returns HOLD instead of crashing the engine.
DXY_SYMBOL=DXY
YIELD_SYMBOL=US10Y
MACRO_INTERVAL=1h

# Comma-separated ISO-8601 UTC timestamps for high-impact events such as
# CPI, NFP or FOMC. Example: 2026-09-04T12:30:00Z,2026-09-16T18:00:00Z
HIGH_IMPACT_EVENTS_UTC=
NEWS_BLOCK_MINUTES=20
