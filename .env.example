# Live XAU/USD and DXY market data are pulled keylessly from Dukascopy.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SYMBOL=XAU/USD
TIMEFRAMES=1min,5min,15min,1h,4h
RESEARCH_INTERVAL=15min
OUTPUT_SIZE=3000
CONTEXT_OUTPUT_SIZE=500
POLL_SECONDS=60
MIN_CONFIDENCE=0.72
MIN_CONSENSUS=3

# Research lab. Failed scheduled refreshes retry on the next runtime cycle.
MAX_CANDIDATES=20000
RESEARCH_CATALOG_SIZE=600
WALK_FORWARD_FOLDS=4
MIN_WALK_FORWARD_FOLDS=2
RESEARCH_EVERY_CYCLES=60

# Strategy Discovery & Evolution Bot. Combines validated strategy outputs into
# experimental ensembles. Nothing reaches live selection until Overfit promotes it.
ENABLE_STRATEGY_EVOLUTION=true
STRATEGY_LIBRARY_PATH=data/discovered_strategies.json
DISCOVERIES_PER_CYCLE=250
DISCOVERY_LIBRARY_SIZE=5000

# Strategy Invention Bot. Creates genuinely new formulas directly from primitive
# price/indicator features, then creates parameter variants of each invented family.
# Invented variants are research-only until the same Overfit Auditor promotes them.
ENABLE_STRATEGY_INVENTION=true
INVENTION_LIBRARY_PATH=data/invented_strategies.json
INVENTED_FAMILIES_PER_CYCLE=6
INVENTED_VARIANTS_PER_FAMILY=8
INVENTION_LIBRARY_SIZE=4000

# Shared promotion gate for both Evolution and Invention. Lifetime tested-trial
# count persists so multiple-testing pressure increases as the search expands.
OVERFIT_MIN_ADJUSTED_SCORE=0.60
OVERFIT_MIN_PROFIT_FACTOR=1.15
OVERFIT_MIN_AVG_R=0.05
OVERFIT_MIN_TRADES=40
OVERFIT_MAX_WF_STD=0.12
OVERFIT_MAX_TRAIN_VALID_GAP=0.15
OVERFIT_MAX_DRAWDOWN_R=10.0
OVERFIT_MAX_LOSS_STREAK=7

# The Boss uses these exact same stop/R:R assumptions as research.
SPREAD_BPS=1.5
SLIPPAGE_BPS=0.5
BACKTEST_STOP_ATR=1.20
BACKTEST_REWARD_RISK=1.70

# Persistent forward outcomes. Recovery prefers completed 1-minute history and
# falls back to completed 5-minute history when needed.
OUTCOME_DB_PATH=data/xau_outcomes.sqlite3
OUTCOME_MAX_AGE_HOURS=72
CALIBRATION_BIN_WIDTH=0.05
CALIBRATION_PRIOR_STRENGTH=20

# Trade-frequency, market-quality and setup-timing policy. A signal must be sent
# shortly after the completed research candle that generated the company setup.
TRADE_TIMEZONE=America/Chicago
MAX_TRADES_PER_DAY=2
MAX_STALE_MULTIPLIER=4.0
MAX_SIGNAL_DELAY_MINUTES=5

PAPER_MODE=true

# Optional macro context. DXY is available from Dukascopy. US10Y is intentionally
# optional until a true yield feed is configured; a Treasury bond price is not used
# as a fake substitute for the 10-year yield.
DXY_SYMBOL=DXY
YIELD_SYMBOL=US10Y
MACRO_INTERVAL=1h

# Comma-separated ISO-8601 UTC timestamps for high-impact events.
HIGH_IMPACT_EVENTS_UTC=
NEWS_BLOCK_MINUTES=20
